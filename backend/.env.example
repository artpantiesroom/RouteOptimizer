# Nominatim configuration
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
# Must identify the actual operator; placeholder values (example.com, ...) are rejected at startup.
NOMINATIM_USER_AGENT=RouteOptimizer-dev/0.1.0 (contact: your@real-domain.example)
NOMINATIM_COUNTRY_CODES=
NOMINATIM_TIMEOUT_SECONDS=10.0
NOMINATIM_RATE_LIMIT_DELAY_SECONDS=1.0

# Routing (OSRM) configuration
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10.0
OSRM_RATE_LIMIT_DELAY_SECONDS=1.0
MATRIX_MAX_POINTS=50

# CORS
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
